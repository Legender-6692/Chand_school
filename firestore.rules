rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // The main admin only (can add and remove sub-admins)
    function isOwner() {
      return signedIn() && myRole() == 'admin';
    }
    // The main admin and sub-admins: the same powers on everything else
    function isAdmin() {
      return signedIn() && myRole() in ['admin', 'subadmin'];
    }
    function isStaff() {
      return signedIn() && myRole() in ['admin', 'subadmin', 'teacher', 'coordinator'];
    }
    // Parent logins are <phone>@parents.chandschool.app
    function isParentOf(phone) {
      return signedIn() && request.auth.token.email == phone + '@parents.chandschool.app';
    }
    function isTeacher() {
      return signedIn() && myRole() == 'teacher';
    }
    function canMarkAttendance() {
      return signedIn() && myRole() in ['admin', 'subadmin', 'coordinator'];
    }

    // Login info: each person can read their own record.
    // Only the main admin can create or change admin-level users (sub-admins).
    // A sub-admin may only create, rename or remove teacher users.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isOwner() || (isAdmin() && request.resource.data.role == 'teacher');
      allow update: if isOwner() || (isAdmin() && resource.data.role == 'teacher' && request.resource.data.role == 'teacher');
      allow delete: if isOwner() || (isAdmin() && resource.data.role == 'teacher');
    }

    // Sub-admin list: main admin only
    match /subadmins/{id} {
      allow read, write: if isOwner();
    }

    // Students: staff can see, only admin can add or change
    match /students/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Teachers: admin can see and change, a teacher can see their own record
    match /teachers/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow write: if isAdmin();
    }

    // Attendance: only admin and coordinator
    match /attendance/{id} {
      allow read, write: if canMarkAttendance();
    }

    // ---- Parent corner ----
    // Each parent signs in with their own phone number and can only open their own family's records.
    // Nobody can list or browse these collections except staff.

    // phone number -> the children linked to it
    match /parentIndex/{phone} {
      allow get: if isAdmin() || isParentOf(phone);
      allow list, write: if isAdmin();
    }

    // Parent passwords: admin only
    match /parentLogins/{phone} {
      allow read, write: if isAdmin();
    }

    // Monthly fee records and payments
    match /fees/{id} {
      allow get: if isAdmin() || isTeacher()
        || (signedIn() && request.auth.token.email == resource.data.parentPhone + '@parents.chandschool.app');
      allow list: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }
    match /feePayments/{id} {
      allow read, write: if isAdmin();
    }

    // School notices: anyone can read, only admin can post
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
