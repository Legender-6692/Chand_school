rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }
    function isStaff() {
      return signedIn() && myRole() in ['admin', 'teacher', 'coordinator'];
    }
    function isParent() {
      return signedIn() && myRole() == 'parent';
    }
    function isTeacher() {
      return signedIn() && myRole() == 'teacher';
    }
    function canMarkAttendance() {
      return signedIn() && myRole() in ['admin', 'coordinator'];
    }

    // Login info: each person can read their own record, only admin can change it
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Students: staff can see, only admin can add or change
    match /students/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Teachers: admin can see and change, a teacher can see their own record
    match /teachers/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == id);
      allow write: if isAdmin();
    }

    // Attendance: staff can see, admin and coordinator can save
    match /attendance/{id} {
      allow read: if isStaff();
      allow write: if canMarkAttendance();
    }

    // ---- Parent corner ----
    // Parents sign in (one shared parent account). They can open ONE record by its exact id.
    // Nobody can list or browse these collections except staff.

    // phone number -> the children linked to it
    match /parentIndex/{phone} {
      allow get: if isAdmin() || isParent();
      allow list, write: if isAdmin();
    }

    // Monthly fee records and payments
    match /fees/{id} {
      allow get: if isAdmin() || isTeacher() || isParent();
      allow list: if isAdmin() || isTeacher();
      allow write: if isAdmin();
    }
    match /feePayments/{id} {
      allow read, write: if isAdmin();
    }

    // School notices: anyone can read, only admin can post
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
